<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config permits cleartext HTTP for local/LAN peer-to-peer media streaming
         (required for embedded byte-range HTTP server on dynamic local Wi-Fi / hotspot IPs) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Strict HTTPS & TLS enforcement for cloud backend and external APIs -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">asia-southeast1.run.app</domain>
        <domain includeSubdomains="true">run.app</domain>
        <domain includeSubdomains="true">google.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">firebaseio.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Explicitly permit cleartext for local loopback and emulator endpoints -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Debug overrides for local JVM testing with robolectric only -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
